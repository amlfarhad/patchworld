# Required only for live Google AI generation. Keep real credentials in .env.
GEMINI_API_KEY=replace-with-your-key

# Optional daemon settings (defaults shown).
# Replay a scripted run instead of calling Gemini: 1 for the catapult fixture,
# a fixture name from src/fixtures/<name>.script.json, or a recorded folder under artifacts/runs/.
# `npm run dev:mock` does the same as ARGON_MOCK=1.
# ARGON_MOCK=0
# Scales the mock's pauses: 0 skips them, 0.5 is twice as fast.
# ARGON_MOCK_SPEED=1
# ARGON_MAX_ITERATIONS=4
# How long the daemon waits for the browser to mount a patched level before treating it as failed.
# ARGON_MOUNT_TIMEOUT_MS=15000
# Model and thinking effort per call (minimal, low, medium, high).
# ARGON_MODEL=gemini-4-argon
# ARGON_WORLD_THINKING=medium
# ARGON_PATCH_THINKING=low
# ARGON_CRITIQUE_THINKING=low
