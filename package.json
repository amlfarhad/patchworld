{
  "name": "physics-sandbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,sync -c cyan,green \"vite\" \"tsx server/syncDaemon.ts\"",
    "dev:vite": "vite",
    "dev:sync": "tsx server/syncDaemon.ts",
    "dev:mock": "concurrently -k -n vite,sync -c cyan,green \"vite\" \"tsx server/syncDaemon.ts --mock\"",
    "test": "node --import tsx --test server/*.test.ts",
    "dry-run": "node --import tsx server/testPush.ts",
    "smoke:google": "node --import tsx server/smokeGoogle.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@google/genai": "^2.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.186.0",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
