{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:hosted",
  "outputDirectory": "dist",
  "functions": {
    "api/argon.ts": {
      "maxDuration": 300,
      "includeFiles": "{.agents/**,src/engine/**,src/generated/**,src/fixtures/**,src/shared/**,tsconfig.app.json,node_modules/@types/**,node_modules/@dimforge/rapier3d-compat/**,node_modules/typescript/lib/*.d.ts}"
    }
  }
}
